# GEMINI_API_KEY: Wajib untuk Scan Nota OCR & AI Asisten FinSight (hanya server-side).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE_URL: Project URL dari Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Service Role secret key dari Supabase (hanya server-side, jangan prefix VITE_).
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# APP_URL: URL publik aplikasi (otomatis terdeteksi dari VERCEL_URL saat deploy jika dikosongkan).
APP_URL="http://localhost:3000"

# SMTP_USER & SMTP_PASS: Opsional untuk pengiriman email verifikasi/reset kata sandi via Gmail App Password.
SMTP_USER="finsight.offc@gmail.com"
SMTP_PASS=""
